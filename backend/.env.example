# Never commit the client secret or the temporary Admin API token it creates.
SHOPIFY_STORE_DOMAIN=t9efbk-0a.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_client_id
SHOPIFY_CLIENT_SECRET=replace_with_client_secret
SHOPIFY_API_VERSION=2026-10
# Reference only; this label is persisted for audit, never the credential itself.
SHOPIFY_CREDENTIALS_REF=env:SHOPIFY_CLIENT_ID

# Persistent local state for the hackathon. Keep this file out of Git.
SETAREH_DATABASE_PATH=setareh.db
SETAREH_BASE_URL=http://127.0.0.1:4020
# Keep loopback locally. Set 0.0.0.0 only behind an HTTPS proxy on deployment.
SETAREH_HTTP_HOST=127.0.0.1
SETAREH_MERCHANT_ID=micohstore
SETAREH_MERCHANT_NAME=Micohstore

# Set this deliberately for the demo and freeze it in every quote. Example only:
# if Shopify prices are in CLP, 0.001 means CLP 10,000 is quoted as 10 USDC.
SETAREH_USDC_PER_CLP=0.001
SETAREH_FX_SOURCE=configured_demo_rate
# Optional fixed demo shipping; it is added to Shopify's draft total and frozen in the quote.
SETAREH_FLAT_SHIPPING_CLP=0
SETAREH_SHIPPING_TITLE=Despacho Setareh
SETAREH_MAX_QUOTE_USDC=30
QUOTE_TTL_MINUTES=10

# Stellar x402 — public address only. Never put a buyer wallet secret here.
STELLAR_NETWORK=stellar:testnet
STELLAR_PAYMENT_ASSET=USDC
STELLAR_MERCHANT_ADDRESS=G_REPLACE_WITH_MICOHSTORE_TESTNET_ADDRESS
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional: starts the HTTP/x402 surface alongside the stdio MCP server.
PORT=4020
