# Never commit the client secret or the temporary Admin API token it creates.
SHOPIFY_STORE_DOMAIN=t9efbk-0a.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_client_id
SHOPIFY_CLIENT_SECRET=replace_with_client_secret
SHOPIFY_API_VERSION=2026-07

# "demo" allows creation of a tagged Shopify draft order after explicit approval.
# "live" is reserved for a Stellar payment verifier, which is intentionally not
# enabled until its destination, asset, amount, and transaction checks are built.
SETAREH_PAYMENT_MODE=demo
