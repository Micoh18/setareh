  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc --project tsconfig.build.json",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "start": "node ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test src/**/*.test.ts",
    "demo:pay": "node ./node_modules/tsx/dist/cli.mjs src/demo-agent.ts",
    "doctor": "node ./node_modules/tsx/dist/cli.mjs src/doctor.ts",
    "reconcile:draft": "node ./node_modules/tsx/dist/cli.mjs src/reconcile-draft.ts",
    "reconcile:order": "node ./node_modules/tsx/dist/cli.mjs src/reconcile-order.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@x402/core": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/stellar": "^2.28.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
