# This file belongs to the local agent runtime, not the Setareh server.
# Never share or commit AGENT_STELLAR_PRIVATE_KEY.
SETAREH_API_URL=http://127.0.0.1:4020
# Identifies this agent to the Setareh API and names the store it buys from. Issued by the Setareh
# team; it is not the wallet secret and cannot move funds. Leave empty against a local service that
# runs with SETAREH_AGENT_AUTH=off.
SETAREH_AGENT_KEY=
AGENT_STELLAR_PRIVATE_KEY=S_REPLACE_WITH_TESTNET_WALLET_SECRET
AGENT_MAX_USDC=30
