---
import emblem from '@setareh/brand/assets/setareh-emblema.svg?raw';
import Glyph from './Glyph.astro';

const docs = 'https://docs.setareh.site';
const links = [
  ['Empezar', `${docs}/primeros-pasos/`],
  ['Integrar', `${docs}/referencia/mcp/`],
  ['Operar', `${docs}/operaciones/estados-y-recuperacion/`],
  ['Evidencia', `${docs}/evidencia/`],
];
const mark = emblem
  .replace(/<svg([^>]*)>/, '<svg$1 aria-hidden="true" focusable="false">')
  .replace(/fill="#B5532A"/gi, 'fill="currentColor"');
---

<header class="nav">
  <a href="/" class="brand" aria-label="Setareh, inicio">
    <span class="mark" set:html={mark} />
    <span class="word" translate="no">Setareh</span>
  </a>

  <nav class="pill" aria-label="Secciones de la documentación">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
    <button type="button" class="theme" data-theme-toggle aria-label="Cambiar tema" title="Cambiar tema">
      <Glyph name="moon" class="moon" />
      <Glyph name="sun" class="sun" />
    </button>
  </nav>

  <div class="mobile">
    <button type="button" class="theme round" data-theme-toggle aria-label="Cambiar tema" title="Cambiar tema">
      <Glyph name="moon" class="moon" size={20} />
      <Glyph name="sun" class="sun" size={20} />
    </button>
    <button type="button" class="round" popovertarget="st-menu" aria-label="Abrir menú">
      <Glyph name="menu" size={20} />
    </button>
  </div>
</header>

<nav id="st-menu" popover class="menu" aria-label="Menú">
  <div class="menu-head">
    <span class="word" translate="no">Setareh</span>
    <button type="button" class="round" popovertarget="st-menu" popovertargetaction="hide" aria-label="Cerrar menú">
      <Glyph name="close" size={20} />
    </button>
  </div>
  {links.map(([label, href]) => <a href={href}>{label}</a>)}
  <a href={`${docs}/primeros-pasos/`} class="st-button st-button--primary">Empezar <Glyph name="arrow-right" /></a>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.25rem 0;
    color: var(--st-on-brand);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: inherit;
  }
  .mark {
    display: inline-flex;
    width: 2.125rem;
    height: 2.125rem;
  }
  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .word {
    font-family: var(--st-font-display);
    font-variation-settings: var(--st-display-settings);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .pill {
    display: none;
    align-items: center;
    gap: 1.75rem;
    padding: 0.375rem 0.5rem 0.375rem 1.5rem;
    border-radius: var(--st-radius-pill);
    background: var(--st-bg);
    color: var(--st-text);
  }
  .pill a {
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.3333;
    color: var(--st-text);
    text-decoration: none;
  }
  .pill a:hover {
    color: var(--st-link);
  }
  .theme,
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--st-radius-pill);
    background: transparent;
    color: var(--st-text);
    cursor: pointer;
  }
  .pill .theme:hover {
    background: var(--st-subtle);
  }
  .mobile {
    display: flex;
    gap: 0.5rem;
  }
  .mobile .round {
    width: 2.75rem;
    height: 2.75rem;
    background: var(--st-bg);
  }
  @media (min-width: 56rem) {
    .nav {
      padding: 1.75rem clamp(1.25rem, 8.33vw, 7.5rem) 0;
    }
    .mark {
      width: 2.5rem;
      height: 2.5rem;
    }
    .word {
      font-size: 2rem;
    }
    .pill {
      display: flex;
    }
    .mobile {
      display: none;
    }
  }

  /* Mobile menu as a popover sheet */
  .menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: var(--st-bg);
    color: var(--st-text);
    display: none;
    flex-direction: column;
    gap: 0.25rem;
  }
  .menu:popover-open {
    display: flex;
  }
  .menu::backdrop {
    background: var(--st-overlay);
  }
  .menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .menu-head .round {
    border: 1px solid var(--st-border);
  }
  .menu > a:not(.st-button) {
    padding: 0.75rem 0.75rem;
    border-radius: var(--st-radius-item);
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--st-text);
    text-decoration: none;
  }
  .menu > a:not(.st-button):hover {
    background: var(--st-subtle);
  }
  .menu > .st-button {
    margin-top: auto;
    justify-content: center;
  }
</style>
