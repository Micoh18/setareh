---
const steps = [
  'Copia el hash completo de una transacción de esta página.',
  'Ábrelo en Horizon testnet y confirma successful: true y el ledger.',
  'Compara el commit de build-info.json con la revisión publicada en GitHub.',
];
---

<section class="verify" aria-labelledby="st-verify-title">
  <h2 id="st-verify-title" class="st-label">Cómo verificar en tres pasos</h2>
  <ol>
    {
      steps.map((s, i) => (
        <li>
          <span class="n" aria-hidden="true">
            {i + 1}
          </span>
          <span>{s}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section {
    margin-top: 2rem;
  }
  .verify h2 {
    margin: 0 0 0.6rem;
    font-size: 0.9375rem;
    color: var(--st-flag-deep);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0.625rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.625rem;
    background: var(--st-void);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    background: var(--st-window);
    color: var(--st-ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .n {
    font-family: var(--st-font-label);
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1;
    color: var(--st-flag-deep);
  }
</style>
