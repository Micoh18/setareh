---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
---

<Default><slot /></Default>

<script>
  // Tables: label each cell with its column so narrow screens can stack rows.
  function stackTables() {
    for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table')) {
      const heads = [...table.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
      if (!heads.length) continue;
      table.classList.add('st-stack');
      for (const row of table.querySelectorAll('tbody tr')) {
        [...row.children].forEach((cell, i) => {
          if (heads[i]) cell.setAttribute('data-label', heads[i]);
        });
      }
    }
  }

  // Quote states in the first column become insignias; colour only marks a
  // real state (closed in error, waiting on review, or created).
  const stateTone: Record<string, string> = {
    created: 'ok',
    expired: 'err',
    payment_failed: 'err',
    out_of_stock: 'err',
    payment_unknown: 'warn',
    manual_review: 'warn',
    shopify_failed: 'warn',
  };
  function badgeStates() {
    for (const code of document.querySelectorAll<HTMLElement>(
      '.sl-markdown-content td:first-child > code:only-child'
    )) {
      const name = code.textContent?.trim() ?? '';
      if (!/^[a-z_]+$/.test(name)) continue;
      code.classList.add('st-badge');
      const tone = stateTone[name];
      if (tone) code.classList.add(`st-badge--${tone}`);
    }
  }

  // Links out to Horizon or the explorer get an outward arrow and the full
  // hash as a tooltip, so the short form stays copyable in context.
  function markExternal() {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.sl-markdown-content a[href^="http"]')) {
      if (link.host === location.host) continue;
      link.classList.add('st-external');
      link.rel = 'noopener';
      const hash = link.href.match(/transactions\/([0-9a-f]{64})$/)?.[1];
      if (hash) link.title = hash;
    }
  }

  // Code blocks carry a tab with the language name, as the design's
  // "código con pestañas"; the copy control sits in that same bar.
  const languageNames: Record<string, string> = {
    powershell: 'PowerShell',
    ps1: 'PowerShell',
    bash: 'Bash',
    sh: 'Shell',
    json: 'JSON',
    toml: 'TOML',
    ini: 'INI',
    http: 'HTTP',
    text: 'Texto',
    txt: 'Texto',
    yaml: 'YAML',
    yml: 'YAML',
    ts: 'TypeScript',
    js: 'JavaScript',
  };
  function labelCodeFrames() {
    for (const frame of document.querySelectorAll<HTMLElement>('.expressive-code figure.frame')) {
      const pre = frame.querySelector<HTMLElement>('pre[data-language]');
      const lang = pre?.dataset.language ?? '';
      const label = languageNames[lang] ?? (lang ? lang.toUpperCase() : '');
      let header = frame.querySelector<HTMLElement>(':scope > .header');
      if (!header) {
        header = document.createElement('figcaption');
        header.className = 'header st-added';
        frame.prepend(header);
      }
      const title = header.querySelector<HTMLElement>('.title');
      if (title && title.textContent?.trim()) continue;
      if (!label) continue;
      const tab = document.createElement('span');
      tab.className = 'st-lang';
      tab.textContent = label;
      header.prepend(tab);
    }
  }

  stackTables();
  badgeStates();
  markExternal();
  labelCodeFrames();
</script>

<style is:global>
  .sl-markdown-content td:first-child > code.st-badge {
    padding: 0.125rem 0.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
  }
  .expressive-code figure.frame > .header.st-added {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.75rem 0 0.5rem;
    border-bottom: 1px solid var(--st-code-border);
    background: var(--st-code-bg);
    border-radius: 12px 12px 0 0;
  }
  .expressive-code figure.frame > .header.st-added::after {
    content: none;
  }
  .expressive-code .st-lang {
    display: inline-block;
    padding: 0.625rem 0.625rem 0.5rem;
    border-bottom: 2px solid #e08a5e;
    color: var(--st-code-text);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.4286;
  }
</style>
