---
import emblem from '../assets/setareh-emblema.svg?raw';

const { siteTitleHref } = Astro.locals.starlightRoute;
// The emblem ships from Figma with a fixed terracota fill; the brand guide
// sets the negative version in light terracota on café, so the fill follows
// the theme token instead.
const svg = emblem
  .replace(/<svg([^>]*)>/, '<svg$1 class="emblem" aria-hidden="true" focusable="false">')
  .replace(/fill="#B5532A"/gi, 'fill="currentColor"');
---

<a href={siteTitleHref} class="site-title" aria-label="Setareh Docs, inicio">
  <span class="mark" set:html={svg} />
  <span class="word" translate="no">Setareh</span>
  <span class="docs">Docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--st-text);
  }
  .mark {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    color: var(--st-logo);
  }
  .mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .word {
    font-family: var(--st-font-display);
    font-weight: 600;
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 72;
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--st-text);
  }
  .docs {
    display: none;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--st-subtle);
    color: var(--st-text-2);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.4286;
  }
  @media (min-width: 30rem) {
    .docs {
      display: inline-block;
    }
  }
  @media (min-width: 50rem) {
    .word {
      font-size: 2.25rem;
    }
  }
</style>
