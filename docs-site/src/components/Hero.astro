---
// The only splash page is the 404: eyebrow, display title, a secondary
// "back home" button and the main pages beneath a rule.
const PAGE_TITLE_ID = '_top';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const pages = [
  ['Primeros pasos', '/primeros-pasos/'],
  ['Referencia MCP', '/referencia/mcp/'],
  ['API HTTP y x402', '/referencia/http-x402/'],
  ['Evidencia pública de referencia', '/evidencia/'],
];
---

<div class="st-404">
  <p class="st-eyebrow">Error 404</p>
  <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
  {tagline && <p class="tagline" set:html={tagline} />}
  {
    actions.length > 0 && (
      <div class="actions">
        {actions.map(({ text, link }) => (
          <a href={link} class="st-button st-button--secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
            {text}
          </a>
        ))}
      </div>
    )
  }
  <hr />
  <p class="st-eyebrow">Páginas principales</p>
  <ul>
    {
      pages.map(([label, href]) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .st-404 {
    max-width: 40rem;
    margin: clamp(2rem, 10vh, 6rem) auto 4rem;
  }
  h1 {
    margin: 1rem 0 0;
    font-family: var(--st-font-display);
    font-weight: 600;
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 144;
    font-size: var(--sl-text-h1);
    line-height: 1.0833;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--st-text);
  }
  .tagline {
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.5556;
    color: var(--st-text-2);
  }
  .actions {
    margin-top: 1.5rem;
  }
  hr {
    margin: 2rem 0 1.5rem;
    border: 0;
    border-top: 1px solid var(--st-border);
  }
  ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  ul a {
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.4286;
    color: var(--st-link);
    text-decoration: none;
  }
  ul a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
