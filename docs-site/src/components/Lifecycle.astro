---
// Quote lifecycle as the rebranding's diagram: the normal path as a chain of
// chips, and the exception states beneath it, each in its own tone. Mirrors
// the tables that follow, which it also points at on hover.
const path = ['quoted', 'payment_required', 'payment_submitted', 'payment_settled', 'creating_shopify_order', 'created'];
const exceptions: [string, 'err' | 'warn'][] = [
  ['expired', 'err'],
  ['out_of_stock', 'err'],
  ['payment_failed', 'err'],
  ['payment_unknown', 'warn'],
  ['manual_review', 'warn'],
];
---

<figure class="life not-content" aria-labelledby="st-life-caption">
  <figcaption id="st-life-caption" class="st-eyebrow">Camino normal</figcaption>
  <ol class="path">
    {
      path.map((state, i) => (
        <li>
          <span class:list={['chip', { ok: state === 'created' }]}>
            <code>{state}</code>
          </span>
          {i < path.length - 1 && (
            <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
  <p class="st-eyebrow">Estados de excepción · detienen los reintentos</p>
  <ul class="exceptions" aria-label="Estados de excepción">
    {
      exceptions.map(([state, tone]) => (
        <li>
          <span class:list={['chip', 'exception', tone]}>
            <code>{state}</code>
          </span>
        </li>
      ))
    }
  </ul>
</figure>

<script>
  // The figure and the tables below describe the same states. Hovering a
  // chip marks its row; hovering a row outlines its chip.
  const chips = new Map<string, HTMLElement>();
  for (const chip of document.querySelectorAll<HTMLElement>('.life .chip')) {
    const name = chip.querySelector('code')?.textContent?.trim();
    if (name) chips.set(name, chip);
  }
  const rows = new Map<string, HTMLTableRowElement>();
  for (const row of document.querySelectorAll<HTMLTableRowElement>('.sl-markdown-content table tbody tr')) {
    const name = row.querySelector('td:first-child > code:only-child')?.textContent?.trim();
    if (name && chips.has(name) && !rows.has(name)) rows.set(name, row);
  }
  for (const [name, chip] of chips) {
    const row = rows.get(name);
    if (!row) continue;
    const on = () => {
      chip.classList.add('st-hit');
      row.classList.add('st-hit');
    };
    const off = () => {
      chip.classList.remove('st-hit');
      row.classList.remove('st-hit');
    };
    for (const el of [chip, row]) {
      el.addEventListener('pointerenter', on);
      el.addEventListener('pointerleave', off);
    }
  }
</script>

<style>
  .life {
    margin: 2rem 0 0;
    padding: 1.5rem;
    border-radius: 16px;
    background: var(--st-subtle);
  }
  figcaption,
  .life > p {
    margin: 0 0 0.75rem;
  }
  .path,
  .exceptions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.625rem;
  }
  .path {
    margin-bottom: 1.5rem;
  }
  .path li,
  .exceptions li {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }
  .arrow {
    color: var(--st-text-2);
    flex: none;
  }
  .chip {
    display: inline-block;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--st-border);
    border-radius: 8px;
    background: var(--st-surface);
    color: var(--st-text);
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: outline-color var(--st-fast) ease-out;
  }
  .chip.ok {
    background: var(--st-ok-bg);
    border-color: var(--st-ok);
    color: var(--st-ok);
  }
  .chip.exception {
    border-color: transparent;
    border-radius: 6px;
    padding: 0.125rem 0.5rem;
  }
  .chip.err {
    background: var(--st-err-bg);
    color: var(--st-err);
  }
  .chip.warn {
    background: var(--st-warn-bg);
    color: var(--st-warn);
  }
  .chip.st-hit {
    outline-color: var(--st-text-3);
  }
  code {
    font-family: var(--st-font-ui);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.4286;
    background: none;
    padding: 0;
    color: inherit;
  }
</style>

<style is:global>
  .sl-markdown-content tr.st-hit td {
    background: var(--st-subtle);
  }
</style>
