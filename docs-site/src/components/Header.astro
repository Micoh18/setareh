---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="header">
  <div class="title-wrapper">
    <SiteTitle />
  </div>
  <div class="search print:hidden">
    <Search />
  </div>
  <div class="right print:hidden">
    <ThemeSelect />
    <a href="/primeros-pasos/" class="st-button st-button--primary start">Empezar</a>
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .title-wrapper {
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .search {
    display: flex;
    margin-inline-start: auto;
  }
  .right {
    display: none;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 50rem) {
    .right {
      display: flex;
    }
    .header {
      display: grid;
      grid-template-columns: auto 1fr auto;
    }
    .search {
      justify-content: flex-end;
    }
  }

  /* Search trigger: a 40 px pill on surface, placeholder text, shortcut key. */
  .search :global(site-search) {
    display: flex;
  }
  .search :global(button[data-open-modal]) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 2.5rem;
    border: 1px solid var(--st-border);
    border-radius: 999px;
    background: var(--st-surface);
    color: var(--st-text-2);
    font-family: var(--st-font-ui);
    font-size: 0.875rem;
    line-height: 1.4286;
    padding: 0 0.5rem 0 0.875rem;
    width: 100%;
    max-width: 20rem;
    cursor: pointer;
  }
  .search :global(button[data-open-modal]:hover) {
    border-color: var(--st-text-3);
    color: var(--st-text);
  }
  .search :global(button[data-open-modal] > span) {
    flex: 1;
    text-align: start;
  }
  .search :global(button[data-open-modal] > svg) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
  .search :global(button[data-open-modal] > kbd) {
    gap: 0.25em;
    padding: 0 0.375rem;
    border: 1px solid var(--st-border);
    border-radius: 6px;
    background: var(--st-subtle);
    color: var(--st-text-2);
    font-family: var(--st-font-ui);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .search :global(button[data-open-modal] > kbd kbd) {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
  }
  @media (min-width: 50rem) {
    .search :global(button[data-open-modal] > kbd) {
      display: inline-flex;
    }
  }
  @media (max-width: 49.99rem) {
    .search :global(button[data-open-modal]) {
      width: 2.5rem;
      padding: 0;
      justify-content: center;
      background: var(--st-bg);
    }
    .search :global(button[data-open-modal] > span),
    .search :global(button[data-open-modal] > kbd) {
      display: none;
    }
  }
</style>
