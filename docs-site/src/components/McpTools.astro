---
const tools: [string, string, 'read' | 'confirm' | 'draft'][] = [
  ['search_catalog', 'Buscar variantes activas en Shopify.', 'read'],
  ['check_availability', 'Reconsultar el stock antes de cotizar.', 'read'],
  ['create_quote', 'Fijar productos, despacho y monto USDC.', 'draft'],
  ['pay_and_place_order', 'Obtener el endpoint x402 que paga la wallet.', 'confirm'],
  ['get_order_status', 'Consultar el estado y un resumen seguro del pago.', 'read'],
];
const effect = {
  read: ['Solo lectura', ''],
  draft: ['Crea un draft · requiere confirmación', 'st-badge--warn'],
  confirm: ['Requiere confirmación', 'st-badge--warn'],
};
---

<section class="tools not-content" aria-labelledby="st-tools-title">
  <h2 id="st-tools-title" class="st-eyebrow">Las cinco herramientas, en orden de uso</h2>
  <ol>
    {
      tools.map(([name, what, kind], i) => (
        <li>
          <span class="n" aria-hidden="true">
            {i + 1}
          </span>
          <div class="body">
            <a href={`#${name}`}>
              <code>{name}</code>
            </a>
            <p>{what}</p>
          </div>
          <span class:list={['st-badge', effect[kind][1]]}>{effect[kind][0]}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .tools {
    margin-top: 2rem;
  }
  h2 {
    margin: 0 0 0.75rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--st-border);
    border-radius: 12px;
    background: var(--st-surface);
    overflow: hidden;
  }
  li {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: start;
    gap: 0.875rem;
    margin: 0;
    padding: 0.875rem;
  }
  li + li {
    border-top: 1px solid var(--st-border);
  }
  .n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--st-border);
    border-radius: 999px;
    background: var(--st-subtle);
    color: var(--st-text-2);
    font-weight: 500;
    font-size: 0.875rem;
  }
  .body {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  a {
    text-decoration: none;
    color: var(--st-link);
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  code {
    font-family: var(--st-font-ui);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.4286;
    background: none;
    padding: 0;
    color: inherit;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4286;
    color: var(--st-text-2);
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: 1.75rem 1fr;
    }
    .st-badge {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
