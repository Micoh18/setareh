<section class="micoh-process color-{{ section.settings.color_scheme }}"><div class="page-width micoh-process__grid"><div><p class="micoh-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="micoh-process__steps">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Proceso Micohstore","settings":[{"type":"text","id":"eyebrow","label":"Antetítulo","default":"No hay dos iguales"},{"type":"textarea","id":"heading","label":"Título","default":"La belleza está\nen el proceso."},{"type":"color_scheme","id":"color_scheme","label":"Esquema de color","default":"scheme-2"}],"blocks":[{"type":"step","name":"Paso","settings":[{"type":"text","id":"title","label":"Título","default":"Elegir el hilo"},{"type":"textarea","id":"text","label":"Texto","default":"Color, textura y la primera idea antes de que exista una forma."}]}],"max_blocks":3,"presets":[{"name":"Proceso Micohstore","blocks":[{"type":"step"},{"type":"step","settings":{"title":"Tejer lento","text":"Cada pieza se hace a mano; las pequeñas diferencias son parte de ella."}},{"type":"step","settings":{"title":"Mandarla a casa","text":"Envuelta con cariño y lista para comenzar otra historia contigo."}}]}]}
{% endschema %}
